# ==========================================
# Shinetek Inc. Enterprise Environment Configuration
# ==========================================

# Server Port
PORT=5000

# MongoDB Connection String
# Local MongoDB: mongodb://localhost:27017/shinetek_db
# MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/shinetek_db?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/shinetek_db

# JWT Authentication Secret Key
JWT_SECRET=your_jwt_secret_key_change_in_production

# Node Environment (development | production)
NODE_ENV=development

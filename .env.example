# ==========================================
# Shinetek Inc. Enterprise Environment Configuration
# ==========================================

# Server Port
PORT=5000

# MongoDB Atlas Cloud Connection String
# Get your connection string from MongoDB Atlas -> Database -> Connect -> Drivers
# Example: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/shinetek_db?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/shinetek_db?retryWrites=true&w=majority

# JWT Authentication Secret Key
JWT_SECRET=your_jwt_secret_key_change_in_production

# Node Environment (development | production)
NODE_ENV=development

# Configure these on the Render backend, not in browser/Vite variables.
# Keep actual credentials in your hosting environment or the ignored .env file.
APP_PUBLIC_URL=https://corporateemployeesignin.vercel.app
INVITATION_FROM_EMAIL=Corporate Employee Portal <invitations@your-verified-domain.example>
RESEND_API_KEY=replace-with-your-server-side-resend-key

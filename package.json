{
  "name": "shineteck",
  "version": "1.0.0",
  "description": "Shinetek Inc. Enterprise Employee Portal & Admin Management System",
  "main": "server/server.js",
  "type": "module",
  "scripts": {
    "server": "node server/server.js",
    "dev:server": "node server/server.js",
    "client": "npm --prefix client run dev",
    "dev:client": "npm --prefix client run dev",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run server\" \"npm run client\"",
    "postinstall": "npm --prefix client install --include=dev",
    "build": "npm --prefix client install --include=dev && npm --prefix client run build",
    "start": "node server/server.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.6.2",
    "concurrently": "^9.2.1",
    "cors": "^2.8.5",
    "csv-parse": "^6.1.0",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.9.2",
    "multer": "^2.0.2",
    "uuid": "^13.0.0",
    "xlsx": "^0.18.5"
  }
}
